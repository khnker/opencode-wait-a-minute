# Arquitectura autocontenida: WAM distribuye su propio catálogo curado.
# Estos directorios son solo contenido build-time del maintainer.

# Repos upstream clonados para regenerar skills/registry.json (scripts/build-registry.cjs)
/upstream/

# Estado runtime del plugin en proyectos del usuario (no debe ir al repo)
/.wam/
# context-query-engine local index/cache
/.cqe/
# Engram AI agent memory
.engram/
node_modules/

# Local search index (tgrep) and editor backups
.tgrep/
*.bak

# Generated benchmark evidence (not source)
/benchmarks/results/
/benchmarks/validation/audit.json
# Prompt audit generated reports (stdout-only by default; --out writes here)
prompts/audit-report.*

# Local benchmark secrets/credentials
.env

.playwright-mcp/

vendor/context-query-core/src/*.ndjson

# Generated CQE indexes/telemetry in the dist mirror of vendor/context-query-core/src
/dist/vendor/context-query-core/src/*.ndjson
/dist/vendor/context-query-core/src/.cache.json
/dist/vendor/context-query-core/src/.bm25-index.json
