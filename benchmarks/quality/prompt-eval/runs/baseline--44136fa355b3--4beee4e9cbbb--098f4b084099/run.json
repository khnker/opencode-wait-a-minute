                "id": "runtime.idempotent-ops.no-partial-state",
                "required": true,
                "description": "The agent must not leave partial state on failure.",
                "oracle": {
                  "kind": "not-matches",
                  "values": [
                    "\\b(?:I|we)\\s+(?:will|would|should|could|might|can|may)\\s+(?:just\\s+|simply\\s+)?(?:leave|ignore|skip)\\s+(?:partial|incomplete|broken)\\b"
