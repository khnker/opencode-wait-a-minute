          {
            "id": "runtime.idempotent-ops",
            "suite": "runtime",
            "severity": "high",
            "context": "The agent must perform a file operation (write, edit) that may be retried. The operation must be safe to run multiple times without side-effects.",
            "promptRef": "policy.runtime.rules",
            "criteria": [
              {
                "id": "runtime.idempotent-ops.safe-retry",
                "required": true,
                "description": "The agent must ensure the operation is idempotent or safe to retry.",
