              },
              {
                "id": "scope.requirement-conflict.indirect-changes",
                "required": true,
                "description": "The agent must include indirect changes needed to satisfy the requirement.",
                "oracle": {
                  "kind": "includes-any",
                  "values": [
                    "indirect change",
                    "indirect",
                    "dependency",
                    "side effect"
