              },
              {
                "id": "discovery.context-first.indexed-lookup",
                "required": false,
                "description": "The agent should prefer indexed search (tgrep, grep, glob) over exhaustive sweeps.",
                "oracle": {
                  "kind": "includes-any",
                  "values": [
                    "tgrep",
                    "grep",
                    "glob",
                    "indexed"
                  ]
