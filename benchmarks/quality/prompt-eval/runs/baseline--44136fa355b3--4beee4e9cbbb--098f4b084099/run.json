              },
              {
                "id": "discovery.context-first.no-reimplementation",
                "required": true,
                "description": "The agent must not reimplement logic that already exists in the codebase.",
                "oracle": {
                  "kind": "not-matches",
                  "values": [
                    "\\b(?:I|we)\\s+(?:will|would|should|could|might|can|may|plan\\s+to|decide\\s+to|decided\\s+to)\\s+(?:just\\s+|simply\\s+)?(?:write|create|build|implement)\\s+(?:a\\s+)?(?:new|fresh|custom)\\b"
