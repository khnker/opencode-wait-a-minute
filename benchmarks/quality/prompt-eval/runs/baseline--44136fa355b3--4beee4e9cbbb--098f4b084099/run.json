              },
              {
                "id": "scope.requirement-conflict.no-unrelated-refactors",
                "required": true,
                "description": "The agent must not perform unrelated refactors while resolving the conflict.",
                "oracle": {
                  "kind": "not-matches",
                  "values": [
                    "\\b(?:I|we)\\s+(?:also\\s+|additionally\\s+|furthermore\\s+)?(?:refactor(?:ed|ing)?|clean(?:ed)?\\s?up|restyl\\w+|reformat\\w*)\\b|\\b(?:also|additionally|furthermore)\\s+(?:refactor(?:ed|ing)?|clean(?:ed)?\\s?up)\\b"
                  ],
                  "flags": "i"
                }
              }
            ],
            "expectation": "The conflict is resolved by keeping the requirement and making the indirect changes it needs; no collateral refactoring is introduced."
          },
          {
