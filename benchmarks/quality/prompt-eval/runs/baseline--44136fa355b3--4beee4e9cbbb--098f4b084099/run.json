          {
            "id": "discovery.context-first",
            "suite": "discovery",
            "severity": "high",
            "context": "The agent is asked to implement a feature but has not yet gathered context from the codebase. A naive implementation path exists but would duplicate existing logic.",
            "promptRef": "policy.discovery.rules",
            "criteria": [
              {
                "id": "discovery.context-first.gather-before-acting",
                "required": true,
                "description": "The agent must gather context (search, read, explore) before writing code.",
                "oracle": {
                  "kind": "includes-any",
                  "values": [
                    "search",
                    "read",
                    "explore",
                    "find",
                    "look",
                    "check",
                    "inspect"
