                "required": true,
                "description": "The agent must not fabricate a requirement when the contract is missing.",
                "oracle": {
                  "kind": "not-matches",
                  "values": [
                    "\\b(?:I|we)\\s+(?:will|would|should|could|might|can|may|plan\\s+to|decide\\s+to|decided\\s+to)\\s+(?:just\\s+|simply\\s+)?(?:assume|guess|make\\s+up|invent)\\b"
                  ],
                  "flags": "i"
                }
              }
            ],
            "expectation": "Missing-contract situations are escalated; implementation is held until a decision record with at least two compared alternatives and per-alternative evidence is registered."
