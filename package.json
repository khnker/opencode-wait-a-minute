{
  "name": "opencode-wait-a-minute",
  "description": "WAM keeps more state than it sends: deterministic task-state, context reconstruction, and evidence-backed completion for OpenCode agents.",
  "version": "1.1.0",
  "main": "index.js",
  "dependencies": {
    "context-query-core": "file:../context-query-core"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "*.js",
    "src/",
    "skills/",
    "prompts/",
    "vendor/**/dist",
    "vendor/**/src/",
    "vendor/**/index.js",
    "README.md",
    "LICENSE",
    "!prompts/fixtures/**",
    "!**/*.test.js",
    "!**/*.test.mjs",
    "!**/bench-*.mjs",
    "!vendor/**/test/**",
    "!vendor/**/benchmarks/**",
    "!**/node_modules/**",
    "!vendor/**/node_modules/**"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "build": "node scripts/build.mjs",
    "gate": "node scripts/release-gate.mjs",
    "rc1": "WAM_RC1_EVIDENCE=1 node scripts/release-gate.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "prompts:check": "node scripts/prompts-check.mjs",
    "prompts:list": "node scripts/prompts-list.mjs",
    "prompts:audit": "node scripts/prompts-audit.mjs",
    "prompts:diff": "node scripts/prompts-diff.mjs",
    "prompts:eval": "node scripts/prompts-eval.mjs",
    "prompts:compare": "node scripts/prompts-compare.mjs",
    "prompts:report": "node scripts/prompts-report.mjs",
    "prompts:calibrate": "node scripts/prompts-calibrate.mjs",
    "benchmark:calibrate": "node scripts/prompts-calibrate.mjs",
    "validate": "node scripts/release-gate.mjs",
    "smoke:bun": "bun scripts/cqe-bun-smoke.mjs",
    "production:gate": "node scripts/release-gate.mjs",
    "release:check": "node scripts/release-gate.mjs",
    "bench:validation": "node benchmarks/run-validation.mjs",
    "bench:audit": "node benchmarks/validation/audit-results.mjs --build",
    "bench:validate": "node benchmarks/validation/audit-results.mjs",
    "benchmark": "node benchmarks/run.mjs",
    "benchmark:real": "node benchmarks/run-real.mjs",
    "benchmark:suite": "node benchmarks/cli.mjs",
    "bench:retrieval": "node benchmarks/retrieval/run-ab.mjs",
    "bench:coupling": "node benchmarks/retrieval/cqe-latency.mjs",
    "bench:semantic-continuity": "node --test --test-force-exit benchmarks/semantic-continuity.test.mjs",
    "bench:continuity-comparison": "node --test --test-force-exit benchmarks/continuity-comparison.test.mjs",
    "report:rc1": "node benchmarks/reports/generate-rc1.mjs",
    "context:shadow-report": "node scripts/context-shadow-report.mjs",
    "pack:test": "node scripts/verify-package.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:version": "node scripts/verify-version-parity.mjs",
    "verify:security": "node scripts/verify-security.mjs",
    "verify:compat": "node scripts/check-compatibility.mjs",
    "verify:published": "node scripts/verify-published-package.mjs",
    "verify:tarball": "node scripts/verify-tarball-install.mjs",
    "smoke": "node -e \"import('./index.js').then(m => console.log('WAM plugin loaded successfully'))\"",
    "skills:sync": "node scripts/sync-upstream.cjs",
    "skills:build": "node scripts/build-registry.cjs",
    "skills:update": "node scripts/sync-upstream.cjs && node scripts/build-registry.cjs",
    "test": "node scripts/run-tests.mjs",
    "test:legacy": "node --test --test-concurrency=1 tests/legacy/wait-a-minute-test.mjs",
    "test:validation": "node --test benchmarks/validation/*.test.mjs",
    "test:e2e:opencode": "node tests/e2e/opencode/smoke.mjs",
    "test:e2e:package": "node scripts/package-e2e.mjs",
    "test:e2e:migration": "node tests/e2e/migration/run.mjs",
    "test:isolation": "node tests/isolation/run.mjs",
    "perf:sanity": "node scripts/performance-sanity.mjs",
    "wam:next": "node scripts/autonomous-task-runner.mjs --all",
    "bench:lifecycle": "node benchmarks/lifecycle-token-savings.mjs",
    "bench:guards": "node benchmarks/guard-metrics-suite.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/khnker/opencode-wait-a-minute.git"
  },
  "homepage": "https://github.com/khnker/opencode-wait-a-minute#readme",
  "bugs": {
    "url": "https://github.com/khnker/opencode-wait-a-minute/issues"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "keywords": [
    "opencode",
    "plugin",
    "coding-agent",
    "task-management",
    "verification",
    "context-management"
  ],
  "license": "MIT",
  "type": "module"
}